  "meta": {
    "titel": "Transformation von Testnormen",
    "beschreibung": "Umrechnungstabelle zwischen verschiedenen Normwertskalen. Ausgangswert ist der AWP (Alterswertpunkt), aus dem alle anderen Skalen direkt ablesbar sind.",
    "spalten": {
      "AWP": "Alterswertpunkt (10+3z), Eingangsgröße",
      "T": "T-Wert (50+10z)",
      "PR": "Prozentrang (kumulierte Prozentwerte f_sum - 1/N * 100)",
      "f_prozent_sum": "Kumulierte relative Häufigkeit in % (f_sum - 1/N)",
      "z": "z-Wert ((Xn - X_quer) / s)",
      "Z": "Z-Wert (100+10z)",
      "IQ": "IQ-Wert (100+15z)",
      "C": "C-Wert (5+2z)",
      "Schulnoten": "Schulnote (3-z)"
    },
    "formeln": {
      "AWP": "10 + 3z",
      "T": "50 + 10z",
      "f_prozent_sum": "(f_sum - 1) / N * 100",
      "Z": "100 + 10z",
      "IQ": "100 + 15z",
      "C": "5 + 2z",
      "Schulnoten": "3 - z"
    },
    "hinweise": [
      "PR-Werte: In Klammern gesetzte Werte im Original sind interpoliert oder gerundet (eigene Berechnung)",
      "f%-Werte: Aus Lienert (1969) übernommen und auf Seite abgerundet",
      "Quelle: Lienert, G.A.: Testaufbau und Testanalyse. Weinheim: Beltz, 3. englische Aufl., 1969, S. 562"
    ]
  },
